{
  "name": "my-typeless",
  "version": "0.0.0",
  "description": "AI-powered voice dictation for Windows",
  "author": "xbghc",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "copy:ort": "node scripts/copy-ort-wasm.mjs",
    "dev": "npm run copy:ort && electron-vite dev",
    "build": "npm run copy:ort && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "rebuild:node": "node scripts/rebuild-sqlite.mjs node",
    "rebuild:electron": "node scripts/rebuild-sqlite.mjs electron",
    "pack:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win --x64 --arm64",
    "dist:arm64": "npm run build && electron-builder --win --arm64",
    "dist:x64": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@fontsource/inter": "^5.2.8",
    "@tailwindcss/forms": "^0.5.11",
    "better-sqlite3": "^12.10.0",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.8.3",
    "ffi-rs": "^1.3.2",
    "material-symbols": "^0.44.10",
    "onnxruntime-web": "^1.26.0",
    "openai": "^6.41.0",
    "opencc-js": "^1.3.1",
    "uiohook-napi": "^1.5.5",
    "undici": "^7.27.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.16.0",
    "@types/opencc-js": "^1.0.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
